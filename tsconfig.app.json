{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "skipLibCheck": true,
      "jsx": "react-jsx",
      "noEmit": true,
      "paths": {
        "@/*": ["./src/*"],
        "chakra-theme/*": ["./node_modules/@chakra-ui/react/dist/types/theme/*"]
      }
    },
    "include": ["src"]
  }